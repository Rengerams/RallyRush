    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "shell-quote": "1.9.0",
    "jsonpath": "1.3.0",
    "nth-check": "2.0.1",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "@tootallnate/once": "2.0.1",
    "axios": {
      "form-data": "4.0.6"
    },
    "jsdom": {
      "form-data": "3.0.5"
    },
    "postcss-svgo": {
