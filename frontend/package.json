    },
    "cssnano": {
      "yaml": "1.10.3"
    },
    "svgo": {
      "js-yaml": "3.15.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "css-loader": {
      "postcss": "8.5.28"
    },
    "css-minimizer-webpack-plugin": {
      "postcss": "8.5.28"
    },
    "filelist": {
      "minimatch": "5.1.8"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
