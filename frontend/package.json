  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "desktop": "node scripts/desktop-dev.cjs",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "homepage": ".",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.renffr.open",
    "productName": "RENFFR OPEN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RENFFR-OPEN-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "react-router": "7.18.4",
    "node-forge": "1.4.0",
    "fast-uri": "3.1.8",
    "flatted": "3.4.2",
    "qs": "6.16.0",
    "diff": "4.0.4",
    "follow-redirects": "1.16.0",
    "path-to-regexp": "0.1.13",
